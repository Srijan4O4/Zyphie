if(NOT DEFINED ZYPH OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "CLI and test root are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/cli-${suffix}")
set(source "${root}/source with spaces")
file(MAKE_DIRECTORY "${source}/nested/empty directory")
string(REPEAT "lossless binary archive integration\n" 1000 content)
file(WRITE "${source}/nested/résumé 文本.txt" "${content}")
file(WRITE "${source}/empty.txt" "")
function(run_ok)
  execute_process(COMMAND "${ZYPH}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Command failed (${code}): ${ARGN}\n${output}\n${error}")
  endif()
endfunction()
foreach(mode store fast balanced maximum)
  set(archive "${root}/${mode}.zyph")
  if(mode STREQUAL "store")
    set(options --store)
  else()
    set(options --preset "${mode}")
  endif()
  run_ok(pack "${source}/" -o "${archive}" ${options} --block-size 16384)
  run_ok(list "${archive}")
  run_ok(info "${archive}")
  run_ok(verify "${archive}")
  run_ok(extract "${archive}" -o "${root}/${mode}-out/")
  file(SHA256 "${source}/nested/résumé 文本.txt" before)
  file(SHA256 "${root}/${mode}-out/source with spaces/nested/résumé 文本.txt" after)
  if(NOT before STREQUAL after OR NOT IS_DIRECTORY "${root}/${mode}-out/source with spaces/nested/empty directory")
    message(FATAL_ERROR "Round-trip content/directory mismatch")
  endif()
  execute_process(COMMAND "${ZYPH}" extract "${archive}" -o "${root}/${mode}-out" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
  if(NOT code EQUAL 6)
    message(FATAL_ERROR "Existing extraction destination was not refused with exit code 6")
  endif()
endforeach()
run_ok(pack "${source}/empty.txt" "${source}/nested/résumé 文本.txt" -o "${root}/multiple.zyph")
run_ok(verify "${root}/multiple.zyph")
file(WRITE "${root}/invalid.zyph" "not an archive")
execute_process(COMMAND "${ZYPH}" verify "${root}/invalid.zyph" RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 4)
  message(FATAL_ERROR "Corrupt archive must return exit code 4")
endif()
# Keep evidence under ignored build/; never recursively remove a caller-supplied path.
run_ok(pack "${source}" -o "${root}/parallel.zyph" --threads 2 --progress)
run_ok(extract "${root}/parallel.zyph" -o "${root}/selected" --select "source with spaces/nested/résumé 文本.txt" --progress)
if(EXISTS "${root}/selected/source with spaces/empty.txt" OR NOT EXISTS "${root}/selected/source with spaces/nested/résumé 文本.txt")
  message(FATAL_ERROR "Selective extraction produced the wrong entries")
endif()
execute_process(COMMAND "${ZYPH}" pack "${source}" -o "${root}/invalid-threads" --threads 0 RESULT_VARIABLE code OUTPUT_QUIET ERROR_QUIET)
if(NOT code EQUAL 2)
  message(FATAL_ERROR "Invalid worker count must return usage error")
endif()
