# Normalise text to LF in the repository. Working-tree endings stay
# platform-native except where CRLF actively breaks a tool, below.
* text=auto

# These are consumed by Linux tooling even when authored on Windows. A CRLF
# Makefile makes GNU make hand `mkdir -p build/dev\r` to the shell, and a CRLF
# shebang line makes the kernel look for an interpreter named `sh\r`.
Makefile      text eol=lf
*.mk          text eol=lf
*.sh          text eol=lf
Dockerfile*   text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Golden compression fixtures are byte-exact by definition: they are the
# mechanism that keeps v1 files decodable forever (format-spec §10). Marking
# them binary explicitly means that guarantee never depends on git's text
# detection heuristic guessing right about a file with no NUL bytes in it.
engine/tests/fixtures/** binary
*.zy                     binary
